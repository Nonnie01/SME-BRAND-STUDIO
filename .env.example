# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Firebase project ID override for server-side ID-token verification.
# Defaults automatically to firebase-applet-config.json projectId when omitted.
# FIREBASE_PROJECT_ID="jittery-tube-3cxst"

# Optional safeguard: set to "true" to require email_verified on all AI endpoints.
# Kept "false" initially so existing accounts and sign-up testers are not unexpectedly blocked.
# Unverified accounts remain tightly capped (2 text requests/day, 0 image-gen requests/day).
REQUIRE_EMAIL_VERIFIED_FOR_AI="false"

# Conservative beta in-memory rate limits and quotas (per server instance).
# NOTE: In-memory limits protect single-instance bursts and concurrency, but reset
# across Cloud Run restarts or multiple instances and are NOT hard durable daily quotas.
AI_TEXT_PER_MIN="4"
AI_TEXT_DAILY_QUOTA="10"
AI_UNVERIFIED_TEXT_DAILY_QUOTA="2"
AI_TEXT_MAX_CONCURRENT="2"
AI_IMAGE_PER_MIN="2"
AI_IMAGE_DAILY_QUOTA="3"
AI_UNVERIFIED_IMAGE_DAILY_QUOTA="0"
AI_IMAGE_MAX_CONCURRENT="1"
AI_IP_PER_MIN="20"

